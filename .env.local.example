NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
RESEND_API_KEY=your-resend-key
# execom RBE checkout (/rbe). Test keys first; run scripts/rbe_stripe_setup.mjs once per mode.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to 1 once Stripe Tax is on and your GST/HST registration is added in Stripe.
STRIPE_AUTOMATIC_TAX=0
# Where new RBE orders are emailed (defaults to action@execom.ca)
RBE_NOTIFY_EMAIL=action@execom.ca
